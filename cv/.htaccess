Options -Indexes

<FilesMatch "\.(sql|ini|log)$">
Order Allow,Deny
Deny from all
</FilesMatch>

RewriteEngine On

# Internally load .php files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/?$ $1.php [L]

# Redirect old .php URLs to clean URLs
RewriteCond %{THE_REQUEST} \s/([^.]+)\.php [NC]
RewriteRule ^ /%1 [R=301,L]